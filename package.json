{
  "name": "angelkiss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap-env": "node scripts/bootstrap-env.mjs",
    "check-env": "node scripts/check-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "admin:import-products": "node scripts/bulk-import-products.mjs",
    "admin:import-folder": "node scripts/import-products-from-folder.mjs",
    "admin:import-studio-prints": "node scripts/import-studio-prints-from-folder.mjs",
    "admin:repair-studio-print-titles": "node scripts/repair-studio-print-titles.mjs",
    "admin:dedupe-studio-prints-trailing": "node scripts/dedupe-studio-prints-trailing-copy.mjs",
    "admin:backfill-studio-print-dims": "node scripts/backfill-studio-print-dimensions.mjs",
    "admin:release-stuck-inventory": "node scripts/release-stuck-inventory.mjs",
    "admin:sync-catalog-images-to-r2": "node scripts/sync-catalog-images-to-r2.mjs",
    "admin:backfill-catalog-images": "node scripts/backfill-catalog-images.mjs",
    "admin:fix-crochet-categories": "node scripts/fix-crochet-categories.mjs",
    "admin:set-print-prices": "node scripts/set-mug-tumbler-prices.mjs",
    "go-live:domain": "node scripts/print-domain-go-live.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:migrations": "node scripts/db-migrations.mjs",
    "db:sql": "node scripts/db-sql-file.mjs",
    "db:newsletter": "node scripts/db-sql-file.mjs supabase/migrations/202604130001_newsletter_subscribers.sql",
    "setup": "npm install && node scripts/bootstrap-env.mjs && node scripts/check-env.mjs",
    "setup:newsletter": "npm run check-env && npm run db:newsletter",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','.open-next']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} } console.log('clean: removed .next/.open-next');\"",
    "dev": "node scripts/dev-best.mjs",
    "dev:win": "npm exec -- next dev -H 127.0.0.1 -p 3010",
    "check:route-revalidate": "node scripts/check-route-revalidate.mjs",
    "build": "npm run check:route-revalidate && next build",
    "build:win": "node scripts/build-best.mjs",
    "build:clean": "npm run clean && npm run build",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "npm run check:route-revalidate && tsc --noEmit",
    "optimize:logo": "node scripts/optimize-brand-logo.mjs",
    "optimize:favicon": "node scripts/optimize-favicon.mjs",
    "optimize:home-gallery": "node scripts/optimize-home-gallery.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "audit:storefront": "node scripts/audit-storefront.mjs",
    "qa:live": "node scripts/live-pass-production.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:psi": "node scripts/pagespeed-insights.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy-best.mjs",
    "deploy:ca": "node scripts/deploy-canonical.mjs",
    "deploy:clean": "npm run clean && opennextjs-cloudflare build && node scripts/verify-opennext-production.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:preflight": "node scripts/cloudflare-preflight.mjs",
    "verify:domains": "node scripts/verify-domain-wiring.mjs",
    "cf:create-unified-token": "node scripts/create-unified-cloudflare-token.mjs",
    "cf:r2-bootstrap": "node scripts/cloudflare-r2-bootstrap.mjs",
    "cf:r2-s3-credentials": "node scripts/cloudflare-r2-create-s3-credentials.mjs",
    "cf:sync-secrets": "node scripts/cloudflare-sync-worker-secrets.mjs",
    "cf:cache-rule": "node scripts/cloudflare-storefront-cache-rule.mjs",
    "cf:cache-rule:ca": "node scripts/cloudflare-storefront-cache-rule.mjs anglkisscreations.ca",
    "cf:cache-rule:image": "node scripts/cloudflare-next-image-cache-rule.mjs",
    "cf:purge-cache": "node scripts/cloudflare-purge-cache.mjs",
    "cf:cache-rule:image:ca": "node scripts/cloudflare-next-image-cache-rule.mjs anglkisscreations.ca",
    "wsl:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wsl-run.ps1 -Command \"npm install && npm run test\"",
    "wsl:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wsl-run.ps1 -Command \"npm install && npm run build:clean\"",
    "wsl:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wsl-run.ps1 -Command \"npm install && npm run deploy:clean\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.787.0",
    "@aws-sdk/s3-request-presigner": "3.787.0",
    "@opennextjs/cloudflare": "^1.8.2",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "lighthouse": "^12.8.2",
    "playwright": "^1.53.2",
    "sharp": "^0.34.2",
    "supabase": "^2.84.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.38.0"
  }
}
