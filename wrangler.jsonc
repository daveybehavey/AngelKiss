{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "angelkisscreations",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Keep in sync with lib/site-domains.ts → WORKER_CUSTOM_DOMAIN_HOSTS
  // .ca: zone routes (existing DNS — custom_domain fails with Cloudflare error 100117)
  "routes": [
    { "pattern": "anglkisscreations.ca/*", "zone_name": "anglkisscreations.ca" },
    { "pattern": "www.anglkisscreations.ca/*", "zone_name": "anglkisscreations.ca" },
    { "pattern": "angelkisscreations.com", "custom_domain": true },
    { "pattern": "www.angelkisscreations.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
