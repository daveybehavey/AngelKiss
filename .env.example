NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL for canonical metadata, redirects, and callbacks (production: https://anglkisscreations.ca)
NEXT_PUBLIC_SITE_URL=
# Bulk import: npm run admin:import-products -- data/imports/your.csv — paste JWT from browser while logged in as admin (expires).
ADMIN_SUPABASE_ACCESS_TOKEN=
# Optional: override origin for import script (defaults to NEXT_PUBLIC_SITE_URL)
# ADMIN_IMPORT_BASE_URL=http://127.0.0.1:3010
# Optional: override hosts that 301 to NEXT_PUBLIC_SITE_URL (default: both .com spellings + www; www.anglkisscreations.ca also redirects when canonical is apex)
# LEGACY_SITE_HOSTS=anglkisscreations.com,www.anglkisscreations.com,angelkisscreations.com,www.angelkisscreations.com
# Cloudflare: one Bearer API token for deploy, purge, cache rules, and R2 (recommended).
# Create via: npm run cf:create-unified-token (needs a token with User → API Tokens → Write, or fix Global API Key + email).
# Permissions: Workers Scripts/Routes, R2, Zone Read, Cache Purge, Cache Rules (zone: anglkisscreations.ca).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional legacy split tokens (scripts prefer CLOUDFLARE_API_TOKEN when set alone):
# CLOUDFLARE_ZONE_API_KEY=
# CLOUDFLARE_TOKEN_API_KEY=
# CLOUDFLARE_ZONE_API_KEY=
# CLOUDFLARE_TOKEN_API_KEY=
# Optional: Global API Key + account email (Wrangler maps key to CLOUDFLARE_API_KEY). Used by deploy, `cf:cache-rule`, and `cf:r2-bootstrap` when set (with email). Do not commit real values.
# CLOUDFLARE_GLOBAL_API_TOKEN=
# CLOUDFLARE_EMAIL=
CLOUDFLARE_ACCOUNT_ID=
# Optional: Bearer API token used only by `npm run cf:r2-bootstrap` and `npm run cf:r2-s3-credentials` (overrides Global+email / CLOUDFLARE_API_TOKEN for those scripts). Scope: R2 + permission to create API tokens if using cf:r2-s3-credentials.
# CLOUDFLARE_R2_API_KEY=
# Optional: zone id for `npm run cf:cache-rule` (use when NEXT_PUBLIC_SITE_URL hostname is not your primary Cloudflare zone)
# CLOUDFLARE_ZONE_ID=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alternative to SUPABASE_SERVICE_ROLE_KEY (new Supabase "Secret Key")
SUPABASE_SECRET_KEY=
# Database password (Settings → Database) — used by `npm run db:push` to apply migrations to the hosted project
SUPABASE_DB_PASSWORD=
# Optional storage bucket for product images (defaults to "product-images")
SUPABASE_PRODUCT_IMAGES_BUCKET=
# Optional private bucket for customer-uploaded custom print images
SUPABASE_CUSTOM_UPLOADS_BUCKET=
# Optional: Supabase Storage signed URL TTL for catalog/studio images (seconds). Higher = fewer re-signs when responses are cached. Default 21600 (6h). Clamped in app to 3600–172800.
# STOREFRONT_STORAGE_SIGNED_URL_TTL_SEC=21600

# Optional: Next.js unstable_cache revalidate for storefront lists / product / studio prints / API (seconds). Default 1800 (30m). Clamped 60–86400.
# If you change this, you must set the same value as numeric literals in app/page.tsx, app/shop/page.tsx, and app/shop/[slug]/page.tsx (`export const revalidate = …`) — `npm run build` runs `check:route-revalidate` to enforce that.
# STOREFRONT_DATA_REVALIDATE_SEC=1800

# --- Cloudflare R2 (catalog + studio images) — cuts Supabase Storage egress ---
# 1) Public base URL for storefront reads (R2 r2.dev or custom hostname — NOT your main site URL).
# NEXT_PUBLIC_IMAGE_CDN_BASE_URL=https://pub-xxxx.r2.dev
# (Host-only values like pub-….r2.dev are OK — the app prepends https://)
# 2) S3-compatible keys for the same bucket — admin uploads go to R2 when all four are set (npm run cf:r2-s3-credentials).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Production: set NEXT_PUBLIC_* at build time + wrangler secret put for R2_* server vars.
# One-time copy existing Supabase objects: npm run admin:sync-catalog-images-to-r2
# Re-encode large catalog JPEG/PNG in R2 as WebP (1600px max edge): npm run admin:backfill-catalog-images -- --dry-run
# Purge entire zone cache (needs Zone → Cache Purge): npm run cf:purge-cache

# Strongly recommended in production: PayPal Webhook ID from the developer dashboard.
# When set, POST /api/webhooks/paypal verifies each event via PayPal verify-webhook-signature before processing.
PAYPAL_WEBHOOK_ID=

# PayPal API credentials
# Use sandbox for development, live for production
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional explicit live/sandbox names (used when PAYPAL_ENV matches)
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Optional alias names (if you prefer "test" naming)
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
# Optional sandbox-only names (server OAuth + same id in browser via NEXT_PUBLIC_* below)
PAYPAL_CLIENTS_DEV_CLIENT=
PAYPAL_CLIENTS_DEV_SECRET=

# Public client id for the PayPal JS button (must match the app you use on the server for PAYPAL_ENV)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional: secret for POST /api/checkout/sessions/expire-stale (cron / maintenance)
CHECKOUT_MAINTENANCE_SECRET=

# Optional (recommended): Cloudflare Web Analytics (free)
# Cloudflare Dashboard → Analytics & Logs → Web Analytics → your site → "Site token"
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
